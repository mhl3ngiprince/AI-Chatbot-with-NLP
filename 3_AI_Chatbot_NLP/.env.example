# ---- Chatbot configuration ----
# Backend: auto | openai | hf | echo
CHAT_BACKEND=auto

# --- OpenAI-compatible endpoint (OpenAI, Groq, vLLM, LM Studio, Ollama) ---
CHAT_MODEL=gpt-4o-mini
CHAT_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Local Ollama example:
#   CHAT_MODEL=llama3.1
#   CHAT_OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama

# --- Local HuggingFace model (needs: pip install torch transformers) ---
CHAT_HF_MODEL=microsoft/DialoGPT-medium

# --- Sampling ---
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=400
CHAT_TOP_P=0.95
CHAT_TIMEOUT=60

# --- Memory + RAG ---
CHAT_DB_PATH=chat.db
CHAT_MAX_HISTORY=10
CHAT_RAG=true
CHAT_RAG_TOP_K=4
CHAT_EMBED_MODEL=all-MiniLM-L6-v2

# --- Safety ---
CHAT_REDACT_PII=true

# --- API ---
CHAT_API_HOST=127.0.0.1
CHAT_API_PORT=8003
